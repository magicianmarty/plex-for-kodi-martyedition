[flake8]
# Errors only. The tree is inherited from upstream and is not style-clean, so
# this is a "does it actually run" gate, not a formatting opinion:
#   E9  syntax/indentation errors     F63  broken comparisons/asserts
#   F7  misplaced statements          F821-F823  undefined or unbound names
#   F811 a name redefined before it was ever used
select = E9,F63,F7,F821,F822,F823,F811
exclude =
    .git,
    .venv*,
    venv,
    lib/_included_packages,
    resources/skins/Main/1080i
max-line-length = 120
